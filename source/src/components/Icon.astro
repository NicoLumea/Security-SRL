---
interface Props {
  name?: string;
  size?: number;
}
const { name = 'arrow', size = 24 } = Astro.props;
const paths: Record<string, string> = {
  arrow: 'M5 12h14m-5-5 5 5-5 5',
  diagonal: 'M6 18 18 6M6 6h12v12',
  camera: 'm3 5 12 2-2 8L1 12 3 5Zm12 3 6 2-2 7-6-2M7 15v5h10',
  access: 'M4 21V3h12v18M9 12h2M16 7h5v14H2',
  alarm: 'M6 17V9a6 6 0 0 1 12 0v8l2 2H4l2-2Zm4 5h4M12 1v2',
  shield: 'm12 2 9 4v6c0 5-9 10-9 10S3 17 3 12V6l9-4Zm-4 9 3 3 5-5',
  plus: 'M12 4v16M4 12h16',
  grid: 'M3 3h6v6H3zM15 3h6v6h-6zM3 15h6v6H3zM15 15h6v6h-6z',
  mail: 'M2 4h20v16H2zM2 5l10 8L22 5',
  phone: 'M5 2 2 5c0 9 8 17 17 17l3-3-5-5-3 2-6-6 2-3-5-5Z',
};
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.3"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name] || paths.arrow} />
</svg>
