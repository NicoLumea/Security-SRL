{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "security-srl",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-07",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
  },
  "vars": {
    "ENVIRONMENT": "locked",
    "DEPLOYMENT_LOCKED": "true",
  },
  "previews": {
    "vars": {
      "ENVIRONMENT": "preview",
      "DEPLOYMENT_LOCKED": "false",
    },
    "d1_databases": [],
    "r2_buckets": [],
  },
}
