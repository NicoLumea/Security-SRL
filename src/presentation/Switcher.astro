---
import { concepts } from '../data/content';
import { copy, type Locale } from '../i18n';
import { conceptRoute, galleryRoute } from '../lib/routes';
import Icon from '../components/Icon.astro';
const { lang = 'ro', active = 'sentinel' } = Astro.props as { lang: Locale; active?: string };
const current = concepts.find((c) => c.id === active)!;
const t = copy[lang];
---

<aside class="presentation-bar" aria-label={t.proposal}>
  <a href={galleryRoute(lang)}>
    <Icon name="grid" size={14} />
    <span>{t.gallery}</span>
  </a>
  <details class="concept-menu">
    <summary>
      <span class="status-dot"></span>
      {current.number} — {current.name} <span aria-hidden="true">⌄</span>
    </summary>
    <nav aria-label={t.gallery}>
      {concepts.map((c) =>
        c.available ? (
          <a href={conceptRoute(lang, c.id)} aria-current={c.id === active ? 'true' : undefined}>
            {c.number} / {c.name}
          </a>
        ) : (
          <span aria-disabled="true">
            {c.number} / {c.name}
            <small>{t.soon}</small>
          </span>
        ),
      )}
    </nav>
  </details>
  <span class="presentation-label">{t.proposal}</span>
</aside>
