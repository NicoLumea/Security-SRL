---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Switcher from '../../presentation/Switcher.astro';
import Brand from '../../components/Brand.astro';
import Icon from '../../components/Icon.astro';
import { copy, type Locale } from '../../i18n';
import { services, projects } from '../../data/content';
import { conceptRoute, galleryRoute } from '../../lib/routes';
import facade from '../../assets/facade.jpg';
import '../../styles/precision.css';
import '../../styles/precision-motion.css';
const { lang } = Astro.props as { lang: Locale };
const t = copy[lang];
const other = lang === 'ro' ? 'en' : 'ro';
const nav = [
  ['services', t.services], ['projects', t.projects],
  ['about', t.about], ['contact', t.contact],
];
const label = lang === 'ro'
  ? { intro: 'SECURITATE / PROIECTATĂ CU CLARITATE', title: 'Protecție.\nPrin precizie.', lead: 'O abordare structurată a securității, construită în jurul spațiului, a oamenilor și a detaliilor care contează.', concept: 'Studiu de concept / 03', index: 'Index de soluții', method: 'Procesul nostru', methodLead: 'De la spațiu la soluție.', evidence: 'Scenarii de prezentare', portfolio: 'Aplicații în context', note: 'Imagini și scenarii demonstrative, nu lucrări executate de companie.', discuss: 'Definim următorul pas.', foot: 'Propunere de website. Informațiile despre servicii necesită confirmarea clientului.', demo: 'Formular demonstrativ: folosiți exclusiv date fictive. Nu se transmite nimic.', legal: 'Informații juridice provizorii.' }
  : { intro: 'SECURITY / ENGINEERED FOR CLARITY', title: 'Protection.\nBy precision.', lead: 'A structured approach to security, built around spaces, people, and the details that matter.', concept: 'Concept study / 03', index: 'Solutions index', method: 'Our process', methodLead: 'From space to solution.', evidence: 'Presentation scenarios', portfolio: 'Applications in context', note: 'Demonstration imagery and scenarios, not projects delivered by the company.', discuss: 'Define the next step.', foot: 'Website proposal. Service information awaits client confirmation.', demo: 'Demonstration form: use fictional details only. Nothing is transmitted.', legal: 'Provisional legal information.' };
---
<Base lang={lang} title={`Precision · ${t.heroTitle}`} description={label.lead} alternate={conceptRoute(other, 'precision')} bodyClass="precision-page">
  <Switcher lang={lang} active="precision" />
  <header class="p-header">
    <div class="p-container p-header-row">
      <Brand href={conceptRoute(lang, 'precision')} />
      <nav class="p-desktop-nav" aria-label={t.menu}>
        {nav.map(([id, title]) => <a href={`#${id}`}>{title}</a>)}
      </nav>
      <div class="p-header-actions">
        <a class="p-language" href={conceptRoute(other, 'precision')} lang={other} aria-label={lang === 'ro' ? 'Switch to English' : 'Schimbă în română'}>{other.toUpperCase()} ↗</a>
        <details class="p-mobile-menu">
          <summary aria-label={t.menu}>{t.menu} <span aria-hidden="true">+</span></summary>
          <nav aria-label={t.menu}>
            {nav.map(([id, title]) => <a href={`#${id}`}>{title}</a>)}
          </nav>
        </details>
      </div>
    </div>
  </header>
  <main id="main">
    <section class="p-hero p-grid-bg p-motion-hero" aria-labelledby="p-hero-title">
      <div class="p-container">
        <div class="p-section-top"><span>03 / PRECISION</span><span>{label.concept}</span></div>
        <div class="p-hero-layout">
          <div class="p-hero-copy">
            <p class="p-eyebrow"><span class="p-point"></span>{label.intro}</p>
            <h1 id="p-hero-title">{label.title.split('\n').map((line) => <span>{line}</span>)}</h1>
            <p class="p-lead">{label.lead}</p>
            <div class="p-actions">
              <a class="p-button" href="#contact">{t.contactUs}<span aria-hidden="true">↗</span></a>
              <a class="p-text-link" href="#services">{t.services} <span aria-hidden="true">↓</span></a>
            </div>
          </div>
          <div class="p-hero-art" aria-hidden="true">
            <div class="p-crosshair"><span></span><span></span><span></span></div>
            <div class="p-art-line p-art-line-one"></div><div class="p-art-line p-art-line-two"></div>
            <div class="p-art-label p-art-label-top">P / 03</div>
            <div class="p-art-label p-art-label-bottom">ENGINEERED.<br />IN EVERY DETAIL.</div>
          </div>
        </div>
        <div class="p-hero-foot"><span>SECURITY SRL / PRECISION</span><a href="#services">{t.scroll} ↓</a></div>
      </div>
    </section>
    <section id="services" class="p-section p-container" aria-labelledby="p-services-title">
      <div class="p-section-top"><span>01 / {label.index}</span><span>01 — 04</span></div>
      <div class="p-section-heading">
        <h2 id="p-services-title">{t.servicesTitle}</h2><p>{t.servicesIntro}</p>
      </div>
      <div class="p-category-carousel" data-p-carousel data-duration="5000" data-transition="850" aria-label={lang === 'ro' ? 'Categorii de soluții' : 'Solution categories'}>
        <div class="p-category-toolbar">
          <span class="p-category-eyebrow">{lang === 'ro' ? 'SELECȚIE / 01—04' : 'SELECTION / 01—04'}</span>
          <div class="p-category-controls">
            <button type="button" data-p-prev aria-label={lang === 'ro' ? 'Categoria anterioară' : 'Previous category'}><span aria-hidden="true">←</span></button>
            <button type="button" data-p-toggle aria-pressed="false" aria-label={lang === 'ro' ? 'Pauză rotație' : 'Pause rotation'}>{lang === 'ro' ? 'Pauză' : 'Pause'} <span aria-hidden="true">Ⅱ</span></button>
            <button type="button" data-p-next aria-label={lang === 'ro' ? 'Categoria următoare' : 'Next category'}><span aria-hidden="true">→</span></button>
          </div>
        </div>
        <div class="p-category-viewport">
          <div class="p-category-track" role="group" aria-label={lang === 'ro' ? 'Selectați o categorie' : 'Choose a category'}>
            {services.map((service, index) => (
              <article class="p-category-card" data-p-card data-index={index} data-title={service[lang].title} data-summary={service[lang].text} data-detail={service[lang].detail}>
                <button type="button" data-p-select aria-pressed={index === 0 ? 'true' : 'false'} aria-describedby={`p-category-description-${index}`}>
                  <span class="p-category-number">0{index + 1} / 04</span>
                  <span class="p-category-icon"><span class="p-category-rings" aria-hidden="true"></span><Icon name={service.icon} size={42} /></span>
                  <span class="p-category-name">{service[lang].title}</span>
                  <span class="p-category-marker" aria-hidden="true">＋</span>
                </button>
                <p id={`p-category-description-${index}`} class="p-category-sr-description">{service[lang].text} {service[lang].detail}</p>
                <div class="p-category-nojs-description"><p>{service[lang].text}</p><p>{service[lang].detail}</p></div>
              </article>
            ))}
          </div>
        </div>
        <div class="p-category-detail" data-p-detail aria-live="off">
          <div class="p-category-detail-index"><span data-p-counter>01 / 04</span><span>{lang === 'ro' ? 'CATEGORIE ACTIVĂ' : 'ACTIVE CATEGORY'}</span></div>
          <h3 data-p-title>{services[0][lang].title}</h3>
          <p class="p-category-summary" data-p-summary>{services[0][lang].text}</p>
          <p class="p-category-description" data-p-description>{services[0][lang].detail}</p>
          <a href="#contact" class="p-category-contact">{t.contactUs} <span aria-hidden="true">↗</span></a>
        </div>
        <p class="p-category-status" role="status" data-p-status aria-live="polite" aria-atomic="true"></p>
      </div>
    </section>
    <section id="about" class="p-section p-method" aria-labelledby="p-about-title">
      <div class="p-container">
        <div class="p-section-top"><span>02 / {label.method}</span><span>PROCESS / 01—03</span></div>
        <div class="p-method-head"><h2 id="p-about-title">{label.methodLead}</h2><p>{t.aboutIntro} {t.aboutPending}</p></div>
        <div class="p-process">{t.processSteps.map((step, i) => <article class="p-motion-enter"><span class="p-index">0{i + 1}</span><h3>{step}</h3><p>{t.processText[i]}</p></article>)}</div>
      </div>
    </section>
    <section id="projects" class="p-section p-container" aria-labelledby="p-projects-title">
      <div class="p-section-top"><span>03 / {label.evidence}</span><span>SELECTED / 02</span></div>
      <div class="p-section-heading"><h2 id="p-projects-title">{label.portfolio}</h2><p>{t.projectsIntro}</p></div>
      <div class="p-projects">{projects.map((project, i) => <article class="p-project p-motion-enter">
        <div class="p-project-media"><Image src={project.image} alt={project[lang].alt} widths={[400, 720, 1100]} sizes="(max-width: 760px) 100vw, 48vw" loading="lazy" style={`object-position:${project.position}`} /><span>{t.demo}</span></div>
        <div class="p-project-top"><span>0{i + 1} / {project[lang].category}</span><span aria-hidden="true">↗</span></div>
        <h3>{project[lang].title}</h3><p>{project[lang].description}</p>
        <details><summary>{t.projectDetail} <span aria-hidden="true">+</span></summary><p>{project[lang].context}</p><p>{project[lang].approach}</p></details>
      </article>)}</div>
      <p class="p-disclaimer">{label.note}</p>
    </section>
    <section class="p-image-band" aria-label={t.illustration}>
      <Image src={facade} alt={projects[0][lang].alt} widths={[640, 1280, 1920]} sizes="100vw" loading="lazy" />
      <div class="p-image-caption p-container"><span>PRECISION / 03</span><span>{t.illustration}</span></div>
    </section>
    <section id="contact" class="p-section p-contact" aria-labelledby="p-contact-title">
      <div class="p-container">
        <div class="p-section-top"><span>04 / {t.contact}</span><span>CONVERSATION / 01</span></div>
        <div class="p-contact-grid">
          <div><h2 id="p-contact-title">{label.discuss}</h2><p>{t.contactIntro}</p><p class="p-disclaimer">{t.contactPending}</p></div>
          <form class="p-form" data-demo-form data-success={t.formSuccess} data-error={t.formError} method="dialog">
            <p>{label.demo}</p>
            <div class="p-form-pair">
              <label>{t.name}<input data-field="name" required minlength="2" maxlength="100" autocomplete="off" /></label>
              <label>{t.email}<input data-field="email" type="email" required maxlength="254" autocomplete="off" /></label>
            </div>
            <label>{t.message}<textarea data-field="message" rows="5" required minlength="10" maxlength="3000"></textarea></label>
            <label class="p-check"><input type="checkbox" data-field="consent" required />{t.consent}</label>
            <button class="p-button" data-demo-submit type="button">{t.submit} <span aria-hidden="true">↗</span></button>
            <p class="form-feedback" role="status" tabindex="-1"></p>
            <noscript>{t.noJs}</noscript>
          </form>
        </div>
      </div>
    </section>
  </main>
  <footer class="p-footer"><div class="p-container">
    <div class="p-footer-head"><Brand href={conceptRoute(lang, 'precision')} /><a href="#main">{t.backHome} ↑</a></div>
    <p>{label.foot}</p>
    <div class="p-footer-legal">
      <details><summary>{t.privacy}</summary><p>{t.privacyText}</p><p>{t.legalNote}</p></details>
      <details><summary>{t.cookies}</summary><p>{t.cookieText}</p></details>
      <button type="button" data-open-consent>{t.preferences}</button>
    </div>
    <div class="p-footer-bottom"><span>© {new Date().getFullYear()} SECURITY SRL</span><a href={galleryRoute(lang)}>{t.gallery} ↗</a><span>03 / PRECISION</span></div>
  </div></footer>
  <script>import '../../scripts/precision';</script>
</Base>
