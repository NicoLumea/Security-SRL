---
import { Image } from 'astro:assets';
import { copy, type Locale, type PageKey } from '../../i18n';
import { services, projects, type Project } from '../../data/content';
import { site } from '../../config/site';
import { route } from '../../lib/routes';
import Icon from '../../components/Icon.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CTA from '../../components/CTA.astro';
import facade from '../../assets/facade.jpg';
const { lang, page, project } = Astro.props as { lang: Locale; page: PageKey; project?: Project };
const t = copy[lang];
const titles = {
  services: t.servicesPageTitle,
  projects: t.projectsPageTitle,
  about: t.aboutPageTitle,
  contact: t.contactTitle,
  privacy: t.privacyTitle,
  cookies: t.cookieTitle,
  login: t.loginTitle,
  home: t.heroTitle,
};
---

<div class="container page-intro">
  <nav class="breadcrumbs" aria-label={lang === 'ro' ? 'Navigare ierarhică' : 'Breadcrumb'}>
    <a href={route(lang)}>{t.home}</a>
    <span aria-hidden="true">/</span>
    {project ? (
      <>
        <a href={route(lang, 'projects')}>{t.projects}</a>
        <span aria-hidden="true">/</span>
        <span>{project[lang].title}</span>
      </>
    ) : (
      <span>{t[page]}</span>
    )}
  </nav>
  <span class="eyebrow">{project ? t.demo : page === 'login' ? 'SECURITY SRL' : t[page]}</span>
  <h1>{project ? project[lang].title : titles[page]}</h1>
  {page === 'services' && <p>{t.servicesPageIntro}</p>}
  {page === 'projects' && !project && <p>{t.projectDisclaimer}</p>}
  {page === 'about' && <p>{t.aboutIntro}</p>}
  {page === 'contact' && <p>{t.contactIntro}</p>}
</div>
{page === 'services' && (
  <>
    <section class="container service-details">
      {services.map((s, i) => (
        <article id={s.id} class="service-detail" data-reveal={i % 2 ? 'fade-right' : 'fade-left'}>
          <span class="service-number">0{i + 1}</span>
          <Icon name={s.icon} size={48} />
          <div>
            <h2>{s[lang].title}</h2>
            <p>{s[lang].detail}</p>
          </div>
          <a
            class="circle-arrow"
            aria-label={`${t.contactUs}: ${s[lang].title}`}
            href={route(lang, 'contact')}
          >
            <Icon name="diagonal" />
          </a>
        </article>
      ))}
    </section>
    <div class="container note">{t.demoNotice}</div>
    <CTA lang={lang} />
  </>
)}
{page === 'projects' && !project && (
  <section class="container portfolio-section">
    <div class="portfolio-tools">
      <div class="filters" data-filters aria-label={t.services}>
        <button class="selected" type="button" data-filter="all" aria-pressed="true">
          {t.all}
        </button>
        {services
          .filter((s) => projects.some((p) => p.category === s.id))
          .map((s) => (
            <button type="button" data-filter={s.id} aria-pressed="false">
              {s[lang].title}
            </button>
          ))}
      </div>
      <label class="search-field">
        <span class="sr-only">{t.search}</span>
        <input type="search" placeholder={t.search} data-project-search />
      </label>
    </div>
    <div class="project-grid" data-reveal-group>
      {projects.map((p) => (
        <ProjectCard project={p} lang={lang} />
      ))}
    </div>
    <p data-empty hidden role="status">
      {t.empty}
    </p>
  </section>
)}
{project && (
  <>
    <article class="container project-detail">
      <div class="detail-cover" data-reveal="fade-right" data-reveal-duration="900">
        <Image
          src={project.image}
          alt={project[lang].alt}
          widths={[600, 1000, 1600]}
          sizes="90vw"
          style={`object-position:${project.position}`}
        />
        <span class="image-label">
          {t.demo} / {t.illustration}
        </span>
      </div>
      <div class="detail-columns">
        <aside data-reveal="fade-left">
          <span class="eyebrow">{t.services}</span>
          <p>{project[lang].category}</p>
          <span class="eyebrow">{t.proposal}</span>
          <p>{t.demo}</p>
        </aside>
        <div>
          <h2 data-reveal="fade-up">{t.context}</h2>
          <p data-reveal="fade-up">{project[lang].context}</p>
          <h2 data-reveal="fade-up">{t.approach}</h2>
          <p data-reveal="fade-up">{project[lang].approach}</p>
          <div class="note" data-reveal="fade-up">
            <Icon name="shield" />
            {t.projectPrivacy}
          </div>
          <a class="text-link" data-reveal="fade-up" href={route(lang, 'projects')}>
            ← {t.backProjects}
          </a>
        </div>
      </div>
    </article>
    <CTA lang={lang} />
  </>
)}
{page === 'about' && (
  <>
    <section class="container about-editorial">
      <div class="editorial-image" data-reveal="fade-right" data-reveal-duration="900">
        <Image src={facade} alt={projects[0][lang].alt} widths={[800, 1400]} sizes="90vw" />
        <span class="image-label">{t.illustration}</span>
      </div>
      <div class="about-statement" data-reveal-group>
        <span class="eyebrow" data-reveal="fade-up">
          SENTINEL / {t.proposal}
        </span>
        <p data-reveal="fade-left">{t.aboutText}</p>
      </div>
      <div class="note" data-reveal="fade-up">
        {t.aboutPending}
      </div>
    </section>
    <section class="section container">
      <div class="section-heading" data-reveal="fade-up">
        <h2>{t.processTitle}</h2>
        <span class="eyebrow">{t.proposal}</span>
      </div>
      <div class="process-grid" data-reveal-group>
        {t.processSteps.map((s, i) => (
          <article data-reveal="fade-scale">
            <span>0{i + 1}</span>
            <h3>{s}</h3>
            <p>{t.processText[i]}</p>
          </article>
        ))}
      </div>
    </section>
    <CTA lang={lang} />
  </>
)}
{page === 'contact' && (
  <section class="container contact-layout">
    <div class="contact-aside" data-reveal="fade-up">
      <Icon name="shield" size={68} />
      <h2>{t.contactUs}</h2>
      <p>{t.contactPending}</p>
      {site.contact.email && (
        <a href={`mailto:${site.contact.email}`}>
          <Icon name="mail" />
          {site.contact.email}
        </a>
      )}
      {site.contact.phone && (
        <a href={`tel:${site.contact.phone}`}>
          <Icon name="phone" />
          {site.contact.phone}
        </a>
      )}
      <div class="contact-line"></div>
      <span class="eyebrow">{t.proposal}</span>
      <p>{t.formNote}</p>
    </div>
    <div class="contact-form">
      <h2 data-reveal="fade-up">{t.formTitle}</h2>
      <p data-reveal="fade-up" data-reveal-delay="100">
        {t.formNote}
      </p>
      <form data-demo-form data-success={t.formSuccess} data-error={t.formError} method="dialog">
        <div class="form-grid">
          <label>
            {t.name}
            <input required minlength="2" maxlength="100" autocomplete="off" data-field="name" />
          </label>
          <label>
            {t.email}
            <input type="email" required maxlength="254" autocomplete="off" data-field="email" />
          </label>
          <label>
            {t.company}
            <input maxlength="150" autocomplete="off" />
          </label>
          <label>
            {t.phone}
            <input type="tel" maxlength="30" autocomplete="off" />
          </label>
        </div>
        <label>
          {t.message}
          <textarea
            rows="5"
            required
            minlength="10"
            maxlength="3000"
            data-field="message"
          ></textarea>
        </label>
        <label class="check-label">
          <input type="checkbox" required data-field="consent" />
          {t.consent}
        </label>
        <button class="button gold" type="button" data-demo-submit>
          {t.submit}
          <Icon name="diagonal" size={20} />
        </button>
        <p class="form-feedback" role="status" aria-live="polite" tabindex="-1"></p>
        <noscript>
          <p>{t.noJs}</p>
        </noscript>
      </form>
    </div>
  </section>
)}
{(page === 'privacy' || page === 'cookies') && (
  <section class="container legal-copy">
    <p>{page === 'privacy' ? t.privacyText : t.cookieText}</p>
    <div class="note">{t.legalNote}</div>
    {page === 'cookies' && (
      <button class="button outline" type="button" data-open-consent>
        {t.preferences}
      </button>
    )}
    <a class="text-link" href={route(lang)}>
      {t.backHome}
      <Icon />
    </a>
  </section>
)}
{page === 'login' && (
  <section class="container legal-copy">
    <Icon name="shield" size={60} />
    <p>{t.loginText}</p>
    <a href={route(lang)} class="button gold">
      {t.backHome}
      <Icon />
    </a>
  </section>
)}
