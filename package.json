{
  "name": "security-srl",
  "version": "1.0.0",
  "description": "Security SRL \u2014 private concept presentation, Astro + Cloudflare Workers",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "preview:worker": "wrangler dev --env preview",
    "validate:worker": "wrangler deploy --env preview --dry-run --outdir .wrangler/dry-run",
    "deploy:preview": "npm run build && wrangler deploy --env preview",
    "verify:build": "node scripts/verify-build.mjs",
    "format": "prettier --write .",
    "preview:static": "astro preview --host 127.0.0.1 --port 4321 --ignore-lock"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "astro": "^7.4.7",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.158.0"
  },
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  }
}
